datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")

}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  cpf       String   @unique
  usuario   String   @unique
  senha     String
  createdAt DateTime @default(now())

  @@map("Usuario")
}

model Lista {
  id        String   @id @default(uuid())
  nome      String
  usuarioId String?
  createdAt DateTime @default(now())
  itens     Item[]

  @@map("Lista")
}

model Item {
  id            String   @id @default(uuid())
  listaId       String
  produtoNome   String
  qtd           Int      @default(1)
  un            String   @default("UN")
  precoEstimado Float?   @default(0.0)
  marca         String?
  marcado       Boolean  @default(false)
  lista         Lista    @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@map("ItemLista")
}