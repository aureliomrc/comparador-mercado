generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id      Int           @id @default(autoincrement())
  nome    String?
  email   String?       @unique
  cupons  CupomFiscal[]
  listas  Lista[]

  @@map("usuarios")
}

model Mercado {
  id              Int                     @id @default(autoincrement())
  nome            String
  cupons          CupomFiscal[]
  historicoPrecos HistoricoPrecoPublico[]

  @@map("mercados")
}

model Produto {
  id              Int                     @id @default(autoincrement())
  nome            String                  @unique
  itensCupom      ItemCupom[]
  historicoPrecos HistoricoPrecoPublico[]

  @@map("produtos")
}

model CupomFiscal {
  id          Int         @id @default(autoincrement())
  chaveAcesso String      @unique
  valorTotal  Decimal     @db.Decimal(10, 2)
  dataEmissao DateTime    @default(now())
  criadoEm    DateTime    @default(now())
  
  mercadoId   Int
  mercado     Mercado     @relation(fields: [mercadoId], references: [id], onDelete: Cascade)

  usuarioId   Int?
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  itens       ItemCupom[]

  @@map("cupons_fiscais")
}

model ItemCupom {
  id            Int         @id @default(autoincrement())
  quantidade    Decimal     @db.Decimal(10, 3)
  precoUnitario Decimal     @db.Decimal(10, 2)

  cupomId       Int
  cupom         CupomFiscal @relation(fields: [cupomId], references: [id], onDelete: Cascade)

  produtoId     Int
  produto       Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("itens_cupom")
}

model HistoricoPrecoPublico {
  id        Int      @id @default(autoincrement())
  preco     Decimal  @db.Decimal(10, 2)
  origem    String   @default("NFC-e")
  criadoEm  DateTime @default(now())

  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  mercadoId Int
  mercado   Mercado  @relation(fields: [mercadoId], references: [id], onDelete: Cascade)

  @@map("historico_precos_publico")
}

// 📌 Tabela Lista atualizada para ser 100% compatível com a sua rota
model Lista {
  id          Int         @id @default(autoincrement())
  nome        String
  isPrincipal Boolean     @default(false)
  usuarioId   Int?
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm    DateTime    @default(now())
  itens       ItemLista[]

  @@map("listas")
}

// 📌 Tabela ItemLista atualizada
model ItemLista {
  id            Int      @id @default(autoincrement())
  nome          String
  qtd           Int      @default(1)
  marcado       Boolean  @default(false)
  precoEstimado Decimal? @db.Decimal(10, 2)
  marca         String?
  
  listaId       Int
  lista         Lista    @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@map("itens_lista")
}